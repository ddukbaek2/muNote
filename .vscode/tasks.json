{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "vite: dev",
			"type": "shell",
			"command": "npm run dev",
			"isBackground": true,
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": {
				"owner": "vite",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
					"file": 1,
					"location": 2,
					"severity": 3,
					"code": 4,
					"message": 5
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "VITE\\s+v",
					"endsPattern": "ready in"
				}
			}
		},
		{
			"label": "vite: dev:stop",
			"type": "shell",
			"windows": {
				"command": "powershell",
				"args": [
					"-NoProfile",
					"-ExecutionPolicy", "Bypass",
					"-Command",
					"$port = 5173; $connections = Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue; if ($connections) { $connections | ForEach-Object { try { Stop-Process -Id $_.OwningProcess -Force -ErrorAction Stop; Write-Host ('[vite:dev:stop] killed PID ' + $_.OwningProcess) } catch {} } } else { Write-Host '[vite:dev:stop] no process on port 5173' }"
				]
			},
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated",
				"close": true
			},
			"problemMatcher": []
		},
		{
			"label": "vite: build",
			"type": "shell",
			"command": "npm run build",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "vite: preview",
			"type": "shell",
			"command": "npm run preview",
			"isBackground": true,
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "npm: install",
			"type": "shell",
			"command": "npm install",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		}
	]
}
